<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Buat Meme" android:textSize="20sp" android:textStyle="bold" android:fontFamily="@font/manrope_bold" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerTemplates"
            android:layout_width="match_parent" android:layout_height="120dp" android:orientation="horizontal" />
        <ImageView android:id="@+id/ivPreview" android:layout_width="match_parent" android:layout_height="300dp"
            android:background="@color/surface" android:layout_marginTop="12dp" android:contentDescription="Pratinjau" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etTop"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Teks atas" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etBottom"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Teks bawah" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.slider.Slider android:id="@+id/sliderTextSize"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:valueFrom="24" android:valueTo="72" android:value="48" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnUpload"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Unggah sebagai post" android:layout_marginTop="12dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSubmitTemplate"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Ajukan Template" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
